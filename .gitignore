# ==========================================
# 1. ARCHIVOS COMPILADOS Y BINARIOS DE JAVA
# ==========================================
*.class
*.log
*.ctxt
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ==========================================
# 2. HERRAMIENTAS DE CONSTRUCCIÓN (BUILD)
# ==========================================
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle
/build/
!gradle/wrapper/gradle-wrapper.jar

# ==========================================
# 3. CONFIGURACIÓN DE EDITORES / IDEs
# ==========================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.metadata
.classpath
.project
.settings/
*.launch

# VS Code
.vscode/

# ==========================================
# 4. EXCEPCIÓN PARA CÓDIGO DE APACHE IMPORTADO
# ==========================================
# Si el código de Apache que importaste vino en formato .java, 
# las reglas de arriba NO lo van a ignorar (lo cual es correcto).
#
# NOTA EXTRA: Si el código de Apache está en carpetas llamadas "target" o "build", 
# Git las ignorará por las reglas de Maven/Gradle. Si ese es tu caso, 
# descomenta (quita el #) las siguientes líneas para forzar a Git a incluirlas:
# !/tu-carpeta-de-apache/

# ==========================================
# 5. CONFIGURACIÓN DE NETBEANS
# ==========================================
nbproject/
nbbuild/
nbdist/
build/
dist/
